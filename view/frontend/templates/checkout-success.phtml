<?php
/** @var \Armanet\Integration\Block\CheckoutSuccess\Index $block */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$helper = $this->helper(\Armanet\Integration\Helper\Data::class);

if ($helper->isTrackingEnabled() && !$helper->isCurrentUserExcluded()) {
    $upcAttr = $helper->getUpcAttribute();
    $items = [];
    foreach ($block->getItems() as $item) {
        $upc = '';
        if ($item->getProduct()) {
            $upc = (string) $item->getProduct()->getData($upcAttr);
        }

        $itemData = [
            'itemId'   => $item->getProductId(),
            'itemName' => $item->getName(),
            'sku'      => $item->getSku(),
            'upc'      => $upc,
            'price'    => $item->getPrice(),
            'quantity' => $item->getQtyOrdered(),
        ];

        $childItems = $item->getChildrenItems();
        if ($childItems && count($childItems) > 0) {
            $firstChild = reset($childItems);
            $itemData['variationId'] = $firstChild->getProductId();
        }

        $items[] = $itemData;
    }

    $coupon = $block->getCouponCode();
    $customer = $block->getCustomerData();

    $payload = [
        'orderNumber' => $block->getOrderId(),
        'orderTotal'  => $block->getOrderTotal(),
        'subtotal'    => $block->getSubtotal(),
        'currency'    => $block->getCurrencyCode(),
        'discount'    => $block->getDiscountAmount(),
        'tax'         => $block->getTaxAmount(),
        'shipping'    => $block->getShippingAmount(),
        'items'       => $items,
        'customer'    => $customer,
    ];

    if ($coupon) {
        $payload['coupon'] = $coupon;
    }

    $payloadJson = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG);
    $debug = $helper->isDebugEnabled() ? 'true' : 'false';

    $scriptContent = "
        require(['checkout_success'], function(checkoutSuccess) {
            checkoutSuccess({$payloadJson}, {$debug});
        });
    ";

    echo $secureRenderer->renderTag('script', [], $scriptContent, false);
}
